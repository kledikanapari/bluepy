+// Splits a received byte stream into complete packets.
+// Packet layout: 0x55 | control (2) | command (2, LE) | length (2, LE) | fsn | payload | CRC16 (2, only if control & 0x20)
+const MAX_PACKET_PAYLOAD = 1024;
+function extractFrames(buffer) {
+    let frames = [];
+    let offset = 0;
+    while (offset < buffer.length) {
+        if (buffer[offset] !== 0x55) {
+            offset++;
+            continue;
+        }
+        if (buffer.length - offset < 8) {
+            break;
+        }
+        let payloadLength = buffer[offset + 5] | (buffer[offset + 6] << 8);
+        if (payloadLength > MAX_PACKET_PAYLOAD) {
+            // Not a real header (0x55 inside garbage data), resync on the next byte
+            offset++;
+            continue;
+        }
+        let crcLength = (buffer[offset + 1] & 0x20) ? 2 : 0;
+        let frameLength = 8 + payloadLength + crcLength;
+        if (buffer.length - offset < frameLength) {
+            break;
+        }
+        frames.push(buffer.slice(offset, offset + frameLength));
+        offset += frameLength;
+    }
+    return { frames: frames, remainder: buffer.slice(offset) };
+}
